+    # REST reviews retain real review IDs and reviewed commit, not discussion verdicts.
+    for page in range(1, PAGE_LIMIT + 1):
+        values = request('reviews', endpoint=f'{prefix}/pulls/{pr["number"]}/reviews?per_page=50&page={page}')
+        if values is None:
