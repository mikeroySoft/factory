+            ('review', {'state': 'DISMISSED'}, 'RV_1'),
+            ('comment', {'line': 9}, 'RC_1'),
+            ('thread', {'isResolved': True}, 'RC_1'),
+            ('check', {'conclusion': 'success'}, 'CR_1'),
+            ('check', {'run_attempt': 2}, 'CR_1'),
